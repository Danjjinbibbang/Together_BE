<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.together.mapper.UserMapper">

    <!-- map-underscore-to-camel-case 가 켜져 있어 KAKAO_ID -> kakaoId 는 자동 매핑된다. -->
    <sql id="columns">
        ID, KAKAO_ID, EMAIL, TERMS_AGREED_AT, TERMS_VERSION, CREATED_AT, WITHDRAWN_AT
    </sql>

    <select id="findById" resultType="User">
        SELECT
        <include refid="columns"/>
        FROM USERS
        WHERE ID = #{id}
    </select>

    <select id="findByKakaoId" resultType="User">
        SELECT
        <include refid="columns"/>
        FROM USERS
        WHERE KAKAO_ID = #{kakaoId}
    </select>

    <!-- ID 는 GENERATED BY DEFAULT AS IDENTITY 라 채번을 DB 에 맡기고 값을 되받는다. -->
    <insert id="insert" parameterType="User"
            useGeneratedKeys="true" keyProperty="id" keyColumn="ID">
        INSERT INTO USERS (KAKAO_ID, EMAIL, TERMS_AGREED_AT, TERMS_VERSION)
        VALUES (#{kakaoId}, #{email}, #{termsAgreedAt}, #{termsVersion})
    </insert>

    <!-- 동의 시각은 애플리케이션 시계가 아니라 DB 시계를 쓴다. -->
    <update id="updateTermsAgreement">
        UPDATE USERS
           SET TERMS_AGREED_AT = SYSTIMESTAMP,
               TERMS_VERSION = #{termsVersion}
         WHERE ID = #{id}
    </update>

    <!--
      FR-043 계정 탈퇴. 개인정보(카카오 회원번호·이메일)를 지우고 탈퇴 시각을 남긴다.
      KAKAO_ID 를 치환하는 것은 UNIQUE 제약을 비켜 같은 카카오 계정의 재가입을 허용하기 위해서다.
      이미 탈퇴한 계정이면 갱신 건수가 0 이라 서비스가 409 로 돌려준다.
    -->
    <update id="withdraw">
        UPDATE USERS
           SET WITHDRAWN_AT = SYSTIMESTAMP,
               KAKAO_ID = 'withdrawn:' || ID,
               EMAIL = NULL
         WHERE ID = #{id}
           AND WITHDRAWN_AT IS NULL
    </update>

</mapper>
